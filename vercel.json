{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": "docs",
  "crons": [
    {
      "path": "/api/cleanup-stale",
      "schedule": "17 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/check-resources",
      "destination": "/api/import-url?mode=check-resources"
    }
  ]
}
